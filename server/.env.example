# InfluxDB bootstrap (used only on first container start)
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change_me_use_a_real_password
INFLUX_ORG=iot-cold-chain
INFLUX_BUCKET=iot_clima
INFLUX_ADMIN_TOKEN=generate_a_long_random_token_here

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_use_a_real_password

# Read-only InfluxDB token used by Grafana's datasource (create this token
# scoped to read-only access on INFLUX_BUCKET after first boot, then put it
# here instead of reusing the admin token)
INFLUX_GRAFANA_READ_TOKEN=generate_a_read_only_token_here
