# InfluxDB configuration
INFLUX_URL=http://influxdb.internal:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=your_org_here
INFLUX_BUCKET=iot_clima

# Location/branch identifier
SUCURSAL_ID=Sucursal_Test

# Host group GIDs for /dev/i2c-1 and /dev/gpiomem (run: getent group i2c gpio).
# These are commonly different GIDs on Raspberry Pi OS; if your host happens
# to have them equal, list the GID only once in docker-compose.yml's group_add.
I2C_GID=997
GPIO_GID=998

# Alert thresholds
UMBRAL_TEMPERATURA=26.0
TIEMPO_COOLDOWN_ALERTA=1800

# Email configuration (SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
EMAIL_REMITENTE=alerts@example.com
EMAIL_PASSWORD=your_smtp_password_here
EMAIL_DESTINO=recipient1@example.com, recipient2@example.com

# ECR configuration (set by provisioning)
ECR_REGISTRY=your_account_id.dkr.ecr.region.amazonaws.com
ECR_IMAGE=your_account_id.dkr.ecr.region.amazonaws.com/iot-cold-chain-monitor:latest
AWS_REGION=us-east-1

# AWS credentials for ECR pull (Raspberry Pi only). Scope this IAM user to
# ecr:GetAuthorizationToken / BatchGetImage / GetDownloadUrlForLayer on this
# one repository - see infra/modules/iam.
AWS_ACCESS_KEY_ID=your_ecr_reader_access_key
AWS_SECRET_ACCESS_KEY=your_ecr_reader_secret_key
