# Copy to terraform.tfvars and fill in - terraform.tfvars is gitignored.
# device_secrets should NOT go here; pass it via TF_VAR_device_secrets or a
# CI secret instead (see README).

aws_region        = "us-east-1"
availability_zone = "us-east-1a"
admin_cidr_blocks = ["203.0.113.10/32"] # your office/VPN/Tailscale CIDR
key_pair_name     = "iot-cold-chain-monitor-admin"
github_org        = "<your-github-username>"
github_repo       = "iot-cold-chain-monitor"
